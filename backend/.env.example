# Copy to .env for local development. Never commit the real .env (README 7, 9.4).
#
# Generate a JWT secret with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=local

# Local PostgreSQL (role/database created per README 9.3)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dataguard
DB_USER=dataguard_app
DB_PASSWORD=replace-with-local-password
DB_SSLMODE=disable

JWT_SECRET=replace-with-random-local-secret
JWT_EXPIRE_MINUTES=30

# Local mode: files under backend/runtime/storage, jobs claimed from the database.
STORAGE_MODE=local
QUEUE_MODE=database
LOCAL_STORAGE_ROOT=runtime/storage

MAX_UPLOAD_BYTES=5242880
MAX_CSV_ROWS=20000
MAX_CSV_COLUMNS=50

# Non-secret tuning values (app/config.py defaults). Uncomment to override.
# JWT_ALGORITHM=HS256
# LEASE_SECONDS=120
# PUBLISHER_INTERVAL_SECONDS=5.0
# DATABASE_QUEUE_POLL_SECONDS=3.0
# ERROR_PREVIEW_LIMIT=100
# DOWNLOAD_URL_TTL_SECONDS=60

# --- AWS mode only (owner: C). Unused while STORAGE_MODE/QUEUE_MODE are local. ---
# Secrets for AWS mode come from Parameter Store SecureString, not this file.
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=dataguard-inputs-<unique-suffix>
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/dataguard-jobs
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<account-id>:dataguard-operators
# SSM_PARAMETER_PREFIX=/dataguard
